{
    "name": "@hwm-1114/markhunter",
    "productName": "MarkHunter",
    "version": "0.2.1",
    "description": "MarkHunter 马克猎手 —— 执笔即江湖，所写皆锋芒",
    "main": "src/main/main.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/hwm-1114/markhunter.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "files": [
        "src/**/*",
        "assets/**/*",
        "scripts/**/*",
        "build/**/*",
        "electron-builder.yml",
        "README.md",
        "README.txt"
    ],
    "scripts": {
        "start": "electron .",
        "build": "node scripts/build.js",
        "build:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i src/renderer/tailwind-input.css -o src/renderer/dist/tailwind.css --minify --silent",
        "dev:css": "node node_modules/@tailwindcss/cli/dist/index.mjs -i src/renderer/tailwind-input.css -o src/renderer/dist/tailwind.css --minify --watch=always",
        "icon": "python scripts/gen_icon.py",
        "smoke": "electron . --smoke",
        "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
    },
    "author": "VibeCode",
    "license": "MIT",
    "devDependencies": {
        "@codemirror/lang-json": "^6.0.1",
        "@codemirror/lang-markdown": "^6.3.4",
        "@codemirror/lang-python": "^6.2.1",
        "@tailwindcss/cli": "^4.3.3",
        "codemirror": "^6.0.2",
        "daisyui": "^5.7.18",
        "electron": "^43.3.0",
        "electron-builder": "^26.0.12",
        "esbuild": "^0.28.2",
        "markdown-it": "^14.1.0",
        "mermaid": "^11.16.1",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "diff": "^9.0.0"
    }
}
